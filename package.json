{
  "name": "ai-selection-explainer",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && vite build --config vite.background.config.ts && vite build --config vite.content.config.ts && node scripts/finalize.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "check:lines": "node scripts/check-file-length.mjs"
  },
  "dependencies": {"react": "^19.0.0", "react-dom": "^19.0.0", "marked": "^18.0.7"},
  "devDependencies": {
    "typescript": "^5.9.3", "@eslint/js": "^10.0.1", "eslint": "^10.0.0", "@typescript-eslint/parser": "^8.59.2",
    "@types/node": "^22.0.0", "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^4.3.4", "vite": "^6.1.0",
    "vitest": "^3.0.0", "jsdom": "^26.0.0", "@playwright/test": "^1.50.0"
  }
}
